*.gnmap

# --- Secrets / local config ---
.env
.env.*
*.pem
*.key
*_id_rsa*

# --- OS / editor junk ---
.DS_Store
.vscode/
.idea/
__pycache__/
*.py[cod]

# --- Framework source is NEVER engagement data (taxonomy reuses these dir names) ---
!framework/**
!.claude/**
# --- Generated indexes (regenerated by build) kept out of PRs as source ---
data/skills_index.json
