#!/usr/bin/env python3
"""
ronin — the Ronin CTF framework command-line tool.

A normal CLI front door for the framework: check/install the pentest tools your OS is
missing, build the per-tool entry files, launch your AI backend (Claude Code / Codex /
Gemini / local model), scaffold an engagement, and lock/unlock the core.

Authorized lab practice only (HTB / TryHackMe / Pro Labs / CPTS-OSCP).

Try:  ronin --help   ·   ronin <command> --help
"""
import argparse, os, platform, shutil, subprocess, sys

ROOT = os.path.dirname(os.path.realpath(__file__))
C = {"g": "\033[32m", "r": "\033[31m", "y": "\033[33m", "b": "\033[36m", "d": "\033[2m", "0": "\033[0m"}
def col(k, s): return f"{C[k]}{s}{C['0']}" if sys.stdout.isatty() else s
def which(b): return shutil.which(b)

# ── OS / package-manager detection ───────────────────────────────────────────
def detect_pm():
    if which("apt-get"): return "apt"
    if which("brew"):    return "brew"
    if which("pacman"):  return "pacman"
    if which("dnf"):     return "dnf"
    if which("zypper"):  return "zypper"
    return None

SUDO = [] if os.geteuid() == 0 else (["sudo"] if which("sudo") else [])
def pm_install(pm, pkgs):
    return {
        "apt":    SUDO + ["apt-get", "install", "-y"] + pkgs,
        "brew":   ["brew", "install"] + pkgs,
        "pacman": SUDO + ["pacman", "-S", "--noconfirm"] + pkgs,
        "dnf":    SUDO + ["dnf", "install", "-y"] + pkgs,
        "zypper": SUDO + ["zypper", "-n", "install"] + pkgs,
    }.get(pm)

# ── tool catalog ─────────────────────────────────────────────────────────────
# each: (group, check, desc, {pm: pkg}, pipx, go)   check = binary name OR path:/some/path
TOOLS = [
    ("recon", "nmap",         "port/service scanner",       {"apt":"nmap","brew":"nmap","pacman":"nmap","dnf":"nmap"}, None, None),
    ("recon", "ffuf",         "web fuzzer",                 {"apt":"ffuf","brew":"ffuf"}, None, "github.com/ffuf/ffuf/v2@latest"),
    ("recon", "gobuster",     "dir/dns/vhost brute",        {"apt":"gobuster","brew":"gobuster"}, None, "github.com/OJ/gobuster/v3@latest"),
    ("recon", "feroxbuster",  "recursive content discovery",{"apt":"feroxbuster","brew":"feroxbuster"}, None, None),
    ("recon", "whatweb",      "web fingerprint",            {"apt":"whatweb"}, None, None),
    ("recon", "nikto",        "web server scanner",         {"apt":"nikto","brew":"nikto"}, None, None),
    ("recon", "smbclient",    "SMB client",                 {"apt":"smbclient"}, None, None),
    ("recon", "snmpwalk",     "SNMP walker",                {"apt":"snmp"}, None, None),
    ("recon", "dig",          "DNS lookups",                {"apt":"dnsutils","brew":"bind","pacman":"bind","dnf":"bind-utils"}, None, None),
    ("recon", "path:/usr/share/seclists", "wordlists (SecLists)", {"apt":"seclists","brew":"seclists"}, None, None),
    ("web",   "sqlmap",       "SQL injection",              {"apt":"sqlmap","brew":"sqlmap"}, None, None),
    ("web",   "nuclei",       "template vuln scanner",      {"apt":"nuclei","brew":"nuclei"}, None, "github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest"),
    ("web",   "wpscan",       "WordPress scanner",          {"apt":"wpscan"}, None, None),
    ("web",   "katana",       "crawler",                    {}, None, "github.com/projectdiscovery/katana/cmd/katana@latest"),
    ("ad",    "nxc",          "netexec (SMB/LDAP/etc.)",    {"apt":"netexec"}, "netexec", None),
    ("ad",    "impacket-secretsdump", "Impacket suite",     {"apt":"impacket-scripts"}, "impacket", None),
    ("ad",    "bloodhound-python", "BloodHound collector",  {"apt":"bloodhound.py"}, "bloodhound", None),
    ("ad",    "certipy",      "AD CS attacks",              {}, "certipy-ad", None),
    ("ad",    "responder",    "LLMNR/NBT-NS poisoner",      {"apt":"responder"}, None, None),
    ("ad",    "hashcat",      "GPU password cracker",       {"apt":"hashcat","brew":"hashcat"}, None, None),
    ("ad",    "john",         "John the Ripper",            {"apt":"john","brew":"john-jumbo"}, None, None),
    ("ad",    "hydra",        "network login brute",        {"apt":"hydra","brew":"hydra"}, None, None),
    ("ad",    "proxychains4", "proxy/tunnel wrapper",       {"apt":"proxychains4","brew":"proxychains-ng"}, None, None),
    ("ad",    "chisel",       "reverse SOCKS tunnel",       {}, None, "github.com/jpillora/chisel@latest"),
]
BACKENDS = [("claude", "Claude Code (full multi-agent)"), ("codex", "Codex CLI"),
            ("gemini", "Gemini CLI"), ("ollama", "Ollama (local models)")]

def present(check):
    if check.startswith("path:"):
        return os.path.exists(check[5:])
    return which(check) is not None

def label(check):
    return check[5:].split("/")[-1] if check.startswith("path:") else check

def plan_for(tool, pm):
    _, check, _, pkgs, pipx, go = tool
    if pm and pm in pkgs:
        return ("pkg", pm_install(pm, [pkgs[pm]]))
    if pipx and which("pipx"):
        return ("pipx", ["pipx", "install", pipx])
    if go and which("go"):
        return ("go", ["go", "install", go])
    # fallbacks that need a prerequisite installed first
    if pipx: return ("need-pipx", None)
    if go:   return ("need-go", None)
    if pm is None: return ("no-pm", None)
    return ("manual", None)

# ── commands ─────────────────────────────────────────────────────────────────
def cmd_doctor(a):
    pm = detect_pm()
    print(col("b", f"\nRonin doctor  ·  {platform.system()} {platform.machine()}  ·  package manager: {pm or 'none detected'}\n"))
    print(col("b", "AI backends"))
    for b, d in BACKENDS:
        ok = present(b); print(f"  {col('g','✓') if ok else col('r','✗')} {b:<8} {col('d', d)}")
    miss = []
    for grp in ("recon", "web", "ad"):
        print(col("b", f"\n{grp} tools"))
        for t in [x for x in TOOLS if x[0] == grp]:
            ok = present(t[1])
            if not ok: miss.append(t)
            print(f"  {col('g','✓') if ok else col('r','✗')} {label(t[1]):<22} {col('d', t[2])}")
    print()
    if miss:
        print(col("y", f"{len(miss)} tool(s) missing.") + f"  Install them with:  {col('b','ronin install')}")
        print(col("d", "  (or a single group:  ronin install --group recon|web|ad)"))
    else:
        print(col("g", "All catalog tools present. You're set."))
    print()

def cmd_install(a):
    pm = detect_pm()
    tools = [t for t in TOOLS if (a.group == "all" or t[0] == a.group)]
    missing = [t for t in tools if not present(t[1])]
    if not missing:
        print(col("g", "Nothing to do — all tools in that group are already installed.")); return
    print(col("b", f"\nPlanning install for {len(missing)} tool(s)  (OS pkg manager: {pm or 'none'})\n"))
    runnable, manual = [], []
    for t in missing:
        kind, cmd = plan_for(t, pm)
        if cmd: runnable.append((t, kind, cmd))
        else:   manual.append((t, kind))
    for t, kind, cmd in runnable:
        print(f"  {col('g','+')} {label(t[1]):<22} {col('d','via '+kind+':')} {' '.join(cmd)}")
    for t, kind in manual:
        hint = {"need-pipx":"install pipx first (ronin install prereqs)","need-go":"install go first",
                "no-pm":"no package manager detected — install manually","manual":"install manually"}.get(kind, kind)
        print(f"  {col('y','!')} {label(t[1]):<22} {col('y', hint)}")
    if not runnable:
        print(col("y", "\nNothing auto-installable here. See hints above.")); return
    if not a.yes:
        try:
            if input(col("y", f"\nRun these {len(runnable)} install command(s)? [y/N] ")).strip().lower() != "y":
                print("aborted."); return
        except EOFError:
            print("\n(non-interactive; re-run with --yes to proceed)"); return
    ok = 0
    for t, kind, cmd in runnable:
        print(col("b", f"\n$ {' '.join(cmd)}"))
        try:
            if subprocess.call(cmd) == 0 and present(t[1]): ok += 1
            else: print(col("r", f"  {label(t[1])} may not have installed cleanly."))
        except Exception as e:
            print(col("r", f"  error: {e}"))
    print(col("g", f"\nDone. {ok}/{len(runnable)} installed. Re-check with: ronin doctor\n"))

def _sh(path, *args):
    p = os.path.join(ROOT, path)
    os.execv(p, [p, *args]) if os.access(p, os.X_OK) else sys.exit(f"not executable: {p}")

def cmd_build(a):  _sh("adapters/build.sh", a.target)
def cmd_lock(a):   _sh("bin/lock.sh")
def cmd_unlock(a): _sh("bin/unlock.sh")

def cmd_start(a):
    if not which(a.backend):
        sys.exit(col("r", f"'{a.backend}' is not installed. See: ronin doctor  ·  docs/SETUP.md"))
    os.chdir(ROOT)
    print(col("d", f"launching {a.backend} in {ROOT} …"))
    os.execvp(a.backend, [a.backend, *a.rest])

def cmd_local(a):
    adv = os.path.join(ROOT, "adapters/local/ronin-advisor.py")
    args = [sys.executable, adv, "--provider", a.provider, "--model", a.model]
    os.execv(sys.executable, args)

def cmd_new(a):
    box = os.path.join(ROOT, a.name)
    if os.path.exists(box): sys.exit(f"'{a.name}/' already exists.")
    for d in ("recon", "web", "loot", "screenshots", "exploit-dev"):
        os.makedirs(os.path.join(box, d), exist_ok=True)
    tgt = a.target or "<CONFIRM AUTHORIZED TARGET>"
    open(os.path.join(box, "scope.txt"), "w").write(
        f"{tgt}\nAuthorized: confirm this is your lab (HTB/THM/Pro Labs/exam). Hard boundary.\n")
    open(os.path.join(box, "notes.md"), "w").write(
        f"# {a.name} — {tgt}\n\nTeaching log (goal → tool/syntax → result → why → next lead).\n")
    open(os.path.join(box, "state.md"), "w").write(
        f"# {a.name} — state\n\nTarget: {tgt}\nOpen ports:\nCreds:\nFoothold:\nCurrent lead:\nNot tried yet:\n")
    open(os.path.join(box, "rabbitholes.md"), "w").write("# Dead-ends (with the reason each was ruled out)\n")
    print(col("g", f"scaffolded {a.name}/") + f"  (scope.txt seeded with: {tgt})")
    if not a.target: print(col("y", "  set the real target in scope.txt before scanning."))

def main():
    p = argparse.ArgumentParser(prog="ronin", description="Ronin — CTF engagement framework CLI (authorized labs only).",
                                epilog="Docs: docs/SETUP.md · docs/HOW-TO-CTF.md · docs/LOCAL-MODELS.md")
    p.add_argument("-V", "--version", action="version", version="ronin 0.1")
    sub = p.add_subparsers(dest="cmd", metavar="<command>")

    sub.add_parser("doctor", help="check which AI backends & pentest tools are installed").set_defaults(fn=cmd_doctor)

    pi = sub.add_parser("install", help="install missing pentest tools for your OS")
    pi.add_argument("--group", choices=["all", "recon", "web", "ad"], default="all", help="which tool group (default: all)")
    pi.add_argument("--yes", action="store_true", help="don't prompt before installing")
    pi.set_defaults(fn=cmd_install)

    pb = sub.add_parser("build", help="(re)generate the per-tool entry files from framework/")
    pb.add_argument("target", nargs="?", default="all", choices=["all", "claude-code", "codex", "gemini"])
    pb.set_defaults(fn=cmd_build)

    ps = sub.add_parser("start", help="launch an AI backend in the repo")
    ps.add_argument("backend", choices=["claude", "codex", "gemini"])
    ps.add_argument("rest", nargs=argparse.REMAINDER, help="extra args passed to the backend")
    ps.set_defaults(fn=cmd_start)

    pl = sub.add_parser("local", help="run the offline advisor against a local model")
    pl.add_argument("--provider", choices=["ollama", "lmstudio"], default="ollama")
    pl.add_argument("--model", required=True, help="model name loaded in your local server")
    pl.set_defaults(fn=cmd_local)

    pn = sub.add_parser("new", help="scaffold an engagement directory for a box")
    pn.add_argument("name"); pn.add_argument("--target", help="the authorized target IP/host")
    pn.set_defaults(fn=cmd_new)

    sub.add_parser("lock", help="make the stable core read-only").set_defaults(fn=cmd_lock)
    sub.add_parser("unlock", help="make the core writable to edit it deliberately").set_defaults(fn=cmd_unlock)

    a = p.parse_args()
    if not getattr(a, "cmd", None): p.print_help(); return
    a.fn(a)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
